{
  "manifest_version": 3,
  "name": "eClass & Echo360 Exporter (YorkU)",
  "version": "1.1.0",
  "description": "Back up YorkU eClass courses and Echo360 lectures (content, files, assignments, forums, transcripts, slides, Q&A, grades) for offline use.",
  "homepage_url": "https://github.com/dattodigm/eclass-exporter",
  "content_scripts": [
    {
      "matches": [
        "https://eclass.yorku.ca/*"
      ],
      "js": [
        "eclass.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://echo360.ca/*"
      ],
      "js": [
        "echo360.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
